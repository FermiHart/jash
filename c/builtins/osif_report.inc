/* This model drives both the Markdown artifact and the native observation.
 * The artifact is rendered from fields, never obtained from terminal output. */
#include <stdarg.h>

typedef struct {
    osif_probe_snapshot_t probes;
    osif_sysid_t host;
    int host_available;
    time_t generated;
    char generated_local[64];
    char name[128];
    char path[256];
    char bytes[16384];
    size_t length;
} osif_report_t;

static int osif_report_append(osif_report_t* report, const char* format, ...)
    __attribute__((format(printf, 2, 3)));

static int osif_report_append(osif_report_t* report, const char* format, ...) {
    va_list args; va_start(args, format);
    int n = vsnprintf(report->bytes + report->length, sizeof report->bytes - report->length, format, args);
    va_end(args);
    if (n < 0 || (size_t)n >= sizeof report->bytes - report->length) { errno = E2BIG; return -1; }
    report->length += (size_t)n; return 0;
}

static int osif_report_prepare(osif_report_t* report) {
    memset(report, 0, sizeof *report);
    const char* target = bear_osinfo_target();
    if (!target || !*target || strchr(target, '/') || strchr(target, '\n') || strchr(target, '\r')) { errno = EINVAL; return -1; }
    int n = snprintf(report->name, sizeof report->name, "%s-conformance.md", target);
    if (n < 0 || (size_t)n >= sizeof report->name) { errno = ENAMETOOLONG; return -1; }
    n = snprintf(report->path, sizeof report->path, "Docs/ports/%s", report->name);
    if (n < 0 || (size_t)n >= sizeof report->path) { errno = ENAMETOOLONG; return -1; }
    osif_probe_snapshot(&report->probes, 1);
    report->host_available = bear_osinfo_sysid(&report->host) == 0;
    report->generated = time(NULL); struct tm local;
    if (report->generated == (time_t)-1 || !localtime_r(&report->generated, &local) ||
        !strftime(report->generated_local, sizeof report->generated_local, "%Y-%m-%d %H:%M:%S", &local)) {
        errno = EIO; return -1;
    }
    const osif_probe_snapshot_t* probes = &report->probes;
    if (osif_report_append(report, "# OSIF Conformance — %s\n\n", target) ||
        osif_report_append(report, "**Generated:** %s by jash `osif report`  \n", report->generated_local) ||
        (report->host_available ? osif_report_append(report, "**Host:** %s %s %s  \n",
            report->host.sysname, report->host.release, report->host.machine) :
            osif_report_append(report, "**Host:** unavailable  \n")) ||
        osif_report_append(report, "**Tier:** %c — %d/%d providers PASS, %d FAIL, %d SKIP\n\n",
            tier_letter(probes->passes, k_nprobes), probes->passes, k_nprobes, probes->failures, probes->skips) ||
        osif_report_append(report, "## Providers\n\n| Cap | Provider | Status | Detail |\n|-----|----------|--------|--------|\n")) return -1;
    for (int i = 0; i < k_nprobes; i++) {
        const char* tag = probes->codes[i] == PROBE_PASS ? "✅ PASS" : probes->codes[i] == PROBE_FAIL ? "❌ FAIL" : "⚪ SKIP";
        if (osif_report_append(report, "| %s | `%s` | %s | ", k_probes[i].cap_name, k_probes[i].probe_name, tag)) return -1;
        for (const char* p = probes->details[i]; *p; p++) {
            if (*p == '|' && osif_report_append(report, "\\")) return -1;
            if (osif_report_append(report, "%c", *p == '\n' || *p == '\r' ? ' ' : *p)) return -1;
        }
        if (osif_report_append(report, " |\n")) return -1;
    }
    return osif_report_append(report, "\n*Generated by ADR-0017 — jash judges its own port.*\n\n*F E R M I ∞ H A R T*\n");
}

static int osif_report_publish(const osif_report_t* report,
                                osif_publish_observer_t observer, void* context,
                                osif_publish_store_t* result) {
    int status = osif_publish_open(result, observer, context);
    if (!status) status = osif_publish_enter(result, "Docs", 1);
    if (!status) status = osif_publish_enter(result, "ports", 1);
    if (!status) status = osif_publish_file(result, report->name, report->bytes, report->length, 1);
    return osif_publish_close(result, status);
}

typedef struct { jash_writer_t writer; void* context; } osif_report_text_t;
static int osif_report_text_observe(void* context, const osif_publish_receipt_t* receipt) {
    osif_report_text_t* output = context;
    if (receipt->error) jash_writef(output->writer, output->context,
        "osif: cannot write %s (%s)\r\n", receipt->path, receipt->error);
    return 0;
}

static int write_report(jash_writer_t writer, void* context) {
    osif_report_t report;
    if (osif_report_prepare(&report)) {
        jash_writes(writer, context, "osif: cannot prepare conformance report\r\n"); return 1;
    }
    osif_report_text_t output = {writer, context}; osif_publish_store_t result;
    int status = osif_report_publish(&report, osif_report_text_observe, &output, &result);
    if (status) return status;
    jash_writef(writer, context, "osif: wrote %s (tier %c, %d/%d)\r\n", report.path,
        tier_letter(report.probes.passes, k_nprobes), report.probes.passes, k_nprobes);
    return report.probes.failures ? 1 : 0;
}
