# GitVersion.cmake — regenerate the build-id header, run at BUILD time.
#
# Why this is not just execute_process() in CMakeLists.txt: that runs at
# CONFIGURE time, so the hash is frozen the moment `cmake -B build` ran. Every
# build after that stamps the binary with a commit it is no longer built from —
# measured here on 2026-08-05, a binary five commits past its configure still
# reported the old short hash, and `jash version` / `--whoami` / the JSON
# envelope all repeated it. Those three are the project's own drift detection
# (JINV-119, Docs/HANDOFF-2026-08-04.md §0), so a stale value there is worse
# than none: it answers confidently and wrong.
#
# Invoked as: cmake -DSRC=<source dir> -DOUT=<header path> -P GitVersion.cmake
#
# The header is only REWRITTEN when the value actually changes, so a normal
# incremental build does not recompile the four files that consume it.
#
# F E R M I ∞ H A R T | SPDX-License-Identifier: LicenseRef-SPL-1.0

if(DEFINED REVISION AND NOT "${REVISION}" STREQUAL "")
    string(SUBSTRING "${REVISION}" 0 7 GITHASH)
    set(GITDIRTY "")
else()
    execute_process(COMMAND git -C ${SRC} rev-parse --short HEAD
                    OUTPUT_VARIABLE GITHASH OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET)
    execute_process(COMMAND git -C ${SRC} status --porcelain
                    OUTPUT_VARIABLE GITDIRTY OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET)
endif()

if(NOT GITHASH)
    set(GITHASH "nogit")
endif()
if(GITDIRTY)
    set(GITHASH "${GITHASH}+dirty")
endif()

set(CONTENT "/* generated by cmake/GitVersion.cmake — do not edit */\n#define JASH_GITHASH \"${GITHASH}\"\n")

set(OLD "")
if(EXISTS ${OUT})
    file(READ ${OUT} OLD)
endif()
if(NOT OLD STREQUAL CONTENT)
    file(WRITE ${OUT} "${CONTENT}")
endif()
