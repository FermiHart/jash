{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:semantic:distill:v1",
  "title": "Jash distill semantic result v1",
  "description": "Bounded complete chain admission and direct temporal/Jaccard/prefix classification, explicitly heuristic. The candidate is constructed metadata; publication reports real atomic rename and directory sync separately. --explain still publishes a recipe. JSON and JSON projection of JTV2 share these fields; native PATH/SYMBOL/FILESIZE and exact I64/U64 retain kinds. JTV2 terminal validation is separately required.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "ok",
        "source",
        "candidate",
        "classification",
        "decisions",
        "keep_reads",
        "explain_requested",
        "substitution",
        "publication",
        "effects_may_have_applied",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.distill.v1"
        },
        "operation": {
          "const": "distill"
        },
        "ok": {
          "type": "boolean"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "present",
            "read_complete",
            "bytes",
            "records",
            "session_markers",
            "cryptographically_verified",
            "command_fidelity",
            "cwd_fidelity",
            "error",
            "errno"
          ],
          "properties": {
            "path": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "encoding",
                    "data"
                  ],
                  "properties": {
                    "encoding": {
                      "const": "base64"
                    },
                    "data": {
                      "type": "string",
                      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                    }
                  }
                }
              ]
            },
            "present": {
              "type": "boolean"
            },
            "read_complete": {
              "type": "boolean"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "records": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "session_markers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "cryptographically_verified": {
              "const": false
            },
            "command_fidelity": {
              "const": "recorded_bytes_only"
            },
            "cwd_fidelity": {
              "const": "legacy_may_replace_spaces_with_underscores"
            },
            "error": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "errno": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "created_seconds",
            "session",
            "range",
            "parameters",
            "step_count",
            "steps"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 56,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "created_seconds": {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            "session": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "encoding",
                    "data"
                  ],
                  "properties": {
                    "encoding": {
                      "const": "base64"
                    },
                    "data": {
                      "type": "string",
                      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                    }
                  }
                }
              ]
            },
            "range": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "to": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                }
              }
            },
            "parameters": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "maxItems": 16
            },
            "step_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "kind",
                  "command"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "kind": {
                    "enum": [
                      "assertion",
                      "command"
                    ]
                  },
                  "command": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "encoding",
                          "data"
                        ],
                        "properties": {
                          "encoding": {
                            "const": "base64"
                          },
                          "data": {
                            "type": "string",
                            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "maxItems": 256
            }
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "causation_verified",
            "fix_similarity_numerator",
            "fix_similarity_denominator",
            "last_window_seconds",
            "timeline_mutations_observed",
            "timeline_scope",
            "fixes",
            "mutations",
            "assertions",
            "reads_dropped"
