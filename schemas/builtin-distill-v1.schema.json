            "fixes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "mutations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "assertions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "reads_dropped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "command_recorded",
              "status_recorded",
              "kept",
              "reason",
              "mutation_in_time_window",
              "similar_prior_failure",
              "assertion_prefix"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "command_recorded": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              },
              "status_recorded": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "kept": {
                "type": "boolean"
              },
              "reason": {
                "enum": [
                  "bookkeeping-skipped",
                  "assertion",
                  "fix",
                  "mutation",
                  "read-kept",
                  "read-dropped"
                ]
              },
              "mutation_in_time_window": {
                "type": "boolean"
              },
              "similar_prior_failure": {
                "type": "boolean"
              },
              "assertion_prefix": {
                "type": "boolean"
              }
            }
          },
          "maxItems": 256
        },
        "keep_reads": {
          "type": "boolean"
        },
        "explain_requested": {
          "type": "boolean"
        },
        "substitution": {
          "const": "literal-text-to-declared-placeholder"
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "applied",
            "durable",
            "bytes_written",
            "error",
            "errno"
          ],
          "properties": {
            "path": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "encoding",
                    "data"
                  ],
                  "properties": {
                    "encoding": {
                      "const": "base64"
                    },
                    "data": {
                      "type": "string",
                      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                    }
                  }
                }
              ]
            },
            "applied": {
              "type": "boolean"
            },
            "durable": {
              "type": "boolean"
            },
            "bytes_written": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                {
                  "type": "null"
                }
              ]
            },
            "error": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "errno": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "effects_may_have_applied": {
          "type": "boolean"
        },
        "error": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.distill.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.distill.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ]
}
