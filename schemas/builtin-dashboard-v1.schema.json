                    },
                    "json": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "agent-guard": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "classifier": {
              "const": "legacy-command-position-heuristic"
            }
          }
        },
        "bypass": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
