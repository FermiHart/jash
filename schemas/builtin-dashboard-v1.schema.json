                            "data"
                          ],
                          "properties": {
                            "encoding": {
                              "const": "base64"
                            },
                            "data": {
                              "type": "string",
                              "contentEncoding": "base64",
                              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "claims": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "claims_live": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "claims_expired": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "checkpoints": {
