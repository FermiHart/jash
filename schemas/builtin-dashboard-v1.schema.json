                "errno",
                "reason",
                "claims",
                "claims_live",
                "claims_expired"
              ],
              "properties": {
                "present": {
                  "type": "boolean"
                },
                "complete": {
                  "type": "boolean"
                },
                "observed_at_seconds": {
                  "type": "integer",
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807
                },
                "status": {
