{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:semantic:dashboard:v1",
  "title": "Jash dashboard semantic result v1",
  "description": "Actual complete bounded chain observations, mesh store snapshot, checkpoint metadata line counts, and engine counters. Sources are independent, not an atomic snapshot; unreadable sources yield null counts. Recorded chain hashes are not verified here. Missing stores are observed empty sources; rates without a denominator and nonmonotonic timestamp spans remain null. JSON and JSON projection of the JTV2 record share this field contract. Native kinds additionally preserve PATH/SYMBOL/FILESIZE and exact I64/U64. The terminal is a separate JTV2 contract; this document alone does not prove stream completion.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "complete",
        "consistency",
        "sources",
        "recording",
        "commands",
        "command_counter_basis",
        "failed",
        "fail_pct",
        "uptime_s",
        "uptime_basis",
        "adoption",
        "bypass",
        "governor",
        "fleet",
        "fleet_observation",
        "board",
        "checkpoints"
      ],
      "properties": {
        "schema": {
          "const": "jash.dashboard.v1"
        },
        "complete": {
          "type": "boolean"
        },
        "consistency": {
          "const": "independent-source-observations"
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chain",
            "mesh",
            "checkpoints"
          ],
          "properties": {
            "chain": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "present",
                "read_complete",
                "bytes",
                "records",
                "session_markers",
                "cryptographically_verified",
                "command_fidelity",
                "cwd_fidelity",
                "error",
                "errno"
              ],
              "properties": {
                "path": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "encoding",
                        "data"
                      ],
                      "properties": {
                        "encoding": {
                          "const": "base64"
                        },
                        "data": {
                          "type": "string",
                          "contentEncoding": "base64",
                          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                        }
                      }
                    }
                  ]
                },
                "present": {
                  "type": "boolean"
                },
                "read_complete": {
                  "type": "boolean"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "records": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "session_markers": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "cryptographically_verified": {
                  "const": false
                },
                "command_fidelity": {
                  "const": "recorded_bytes_only"
                },
                "cwd_fidelity": {
                  "const": "legacy_may_replace_spaces_with_underscores"
                },
                "error": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "errno": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "mesh": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "present",
                "complete",
                "observed_at_seconds",
