{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:cwd:v1",
  "type": "object",
  "required": [
    "schema",
    "command",
    "complete",
    "status",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "jash.cwd.v1"
    },
    "command": {
      "enum": [
        "cd"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "items": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "requested",
          "before",
          "cwd",
          "physical_cwd",
          "logical",
          "changed",
          "errno",
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "requested": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "encoding",
                  "data"
                ],
                "additionalProperties": false,
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              }
            ]
          },
          "before": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "encoding",
                  "data"
                ],
                "additionalProperties": false,
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              }
            ]
          },
          "cwd": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "encoding",
                  "data"
                ],
                "additionalProperties": false,
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              }
            ]
          },
          "physical_cwd": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "logical": {
            "type": "boolean"
          },
          "changed": {
            "type": "boolean"
          },
          "errno": {
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "effects_may_have_applied"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "collection_limit_exceeded"
        },
        "effects_may_have_applied": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "status": {
            "const": 75
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
