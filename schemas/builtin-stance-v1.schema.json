{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:semantic:stance:v1",
  "title": "Jash stance semantic result v1",
  "description": "Actual stance configuration. A setter changes only the current shell process. JSON and JSON projection of the JTV2 record share this field contract. Native kinds additionally preserve PATH/SYMBOL/FILESIZE and exact I64/U64. The terminal is a separate JTV2 contract; this document alone does not prove stream completion.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "scope",
        "ok",
        "changed",
        "stances"
      ],
      "properties": {
        "schema": {
          "const": "jash.stance.v1"
        },
        "operation": {
          "enum": [
            "show",
            "list",
            "set"
          ]
        },
        "scope": {
          "const": "shell-process"
        },
        "ok": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        },
        "stances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "description",
              "active",
              "context_budget_tokens",
              "digest_level",
              "priority_tags"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "name": {
                "enum": [
                  "explore",
                  "build",
                  "debug",
                  "review",
                  "deploy"
                ]
              },
              "description": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              },
              "active": {
                "type": "boolean"
              },
              "context_budget_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "digest_level": {
                "enum": [
                  "brief",
                  "standard",
                  "deep"
                ]
              },
              "priority_tags": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807
                },
                "maxItems": 8
              }
            }
          },
          "maxItems": 5,
          "minItems": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.stance.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.stance.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ]
}
