{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:persist:v1",
  "title": "Jash persist native report v1",
  "description": "Checked shell state persistence. Applied and durable are distinct: a published rename/unlink can remain applied if directory fsync fails. Restore merges env/aliases; CWD is restored only in interactive mode and errors after a merge preserve applied=true. Counters report serialized/restored entries, not a diff. Stateful operations admit a checked header before effects and flush each receipt before the next action. Mutation receipts bypass presentation budgets. Collection failure after admission retains prior receipts with complete:false, status:75 and effects_may_have_applied:true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "complete",
    "status",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "jash.persist.v1"
    },
    "command": {
      "enum": [
        "jash_state"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "items": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "path",
          "applied",
          "durable",
          "cwd_applied",
          "cwd_policy",
          "env_entries",
          "alias_entries",
          "ok",
          "error",
          "errno"
        ],
        "properties": {
          "operation": {
            "enum": [
              "save",
              "restore",
              "clear"
            ]
          },
          "path": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              }
            ]
          },
          "applied": {
            "type": "boolean"
          },
          "durable": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "cwd_applied": {
            "type": "boolean"
          },
          "cwd_policy": {
            "enum": [
              "interactive-only",
              null
            ]
          },
          "env_entries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "alias_entries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "errno": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "effects_may_have_applied"
      ],
      "properties": {
        "code": {
          "const": "collection_limit_exceeded"
        },
        "effects_may_have_applied": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "status": {
            "const": 75
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
