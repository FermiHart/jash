{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:osif-row:v1",
  "title": "OSIF native observations and filesystem target receipts",
  "description": "Probe failures are completed observations. Receipt applied/durable refer to the named filesystem target; temporary_created and temporary_retained describe staging separately. Existing file durability is unknown. Matrix counts are recorded report fields, not a live or cryptographic verification.",
  "oneOf": [
    {
      "$ref": "#/$defs/probe"
    },
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/matrix"
    },
    {
      "$ref": "#/$defs/explanation"
    },
    {
      "$ref": "#/$defs/effect"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/summary"
    }
  ],
  "$defs": {
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "operation",
        "target",
        "capability",
        "bit",
        "provider",
        "advertised",
        "status",
        "detail"
      ],
      "properties": {
        "record": {
          "const": "probe"
        },
        "operation": {
          "enum": [
            "report"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "capability": {
          "enum": [
            "SYSID",
            "PROC",
            "MEM",
            "MOUNTS",
            "NET",
            "UPTIME",
            "LOADAVG",
            "SPAWN"
          ]
        },
        "bit": {
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32,
            64,
            128
          ]
        },
        "provider": {
          "enum": [
            "sysid",
            "proc_iter",
            "meminfo",
            "mounts",
            "netstat",
            "uptime",
            "loadavg",
            "spawn"
          ]
        },
        "advertised": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "skip"
          ]
        },
        "detail": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "operation",
        "target",
        "tier",
        "passed",
        "failed",
        "skipped",
        "total",
        "artifact_bytes",
        "path",
        "generated_seconds",
        "generated_local",
        "host",
        "phase"
      ],
      "properties": {
        "record": {
          "const": "report"
        },
        "operation": {
          "enum": [
            "report"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "tier": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "path": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "generated_seconds": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "generated_local": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
        },
        "host": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sysname",
                "release",
                "machine"
              ],
              "properties": {
                "sysname": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/bytes"
                    }
                  ]
                },
                "release": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/bytes"
                    }
                  ]
                },
                "machine": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/bytes"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "const": "prepared"
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "operation",
        "target",
        "tier",
        "passed",
        "failed",
        "skipped",
        "total",
        "artifact_bytes",
        "path",
        "evidence",
        "verification"
      ],
      "properties": {
        "record": {
          "const": "matrix"
        },
        "operation": {
          "enum": [
            "matrix"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "tier": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "path": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "evidence": {
          "const": "recorded-report"
        },
        "verification": {
          "const": "format-only"
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "operation",
        "target",
        "provider",
        "capability",
        "contract",
        "source"
      ],
      "properties": {
        "record": {
          "const": "explanation"
        },
        "operation": {
          "enum": [
            "explain"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "provider": {
          "enum": [
            "sysid",
            "proc",
            "mem",
            "mounts",
            "net",
            "uptime",
            "loadavg",
            "spawn"
          ]
        },
        "capability": {
          "enum": [
            "SYSID",
            "PROC",
            "MEM",
            "MOUNTS",
            "NET",
            "UPTIME",
            "LOADAVG",
            "SPAWN"
          ]
        },
        "contract": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "source": {
          "const": "builtin-provider-contract"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "operation",
        "target",
        "phase",
        "action",
        "path",
        "ok",
        "error",
        "errno",
        "applied",
        "durable",
        "expected_bytes",
        "written_bytes",
        "existing_bytes",
        "temporary_created",
        "temporary_retained",
        "cleanup_errno"
      ],
      "properties": {
        "record": {
          "const": "effect"
        },
        "operation": {
          "enum": [
            "report",
            "port",
            "matrix"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "phase": {
          "enum": [
            "mkdir",
            "publish",
            "open-directory",
            "close-directory"
          ]
        },
        "action": {
          "enum": [
            "created",
            "replaced",
            "preserved",
            "failed"
          ]
        },
        "path": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "applied": {
          "type": "boolean"
        },
        "durable": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "written_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "existing_bytes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "temporary_created": {
          "type": "boolean"
        },
        "temporary_retained": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanup_errno": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              },
              "errno": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "string",
                "minLength": 1
              },
              "errno": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "preserved"
              }
            }
          },
          "then": {
            "properties": {
              "applied": {
                "const": false
              },
              "durable": {
                "type": "null"
              },
              "written_bytes": {
                "const": 0
              },
              "temporary_created": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "durable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "applied": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "operation",
        "target",
        "path",
        "error",
        "errno",
        "status"
      ],
      "properties": {
        "record": {
          "const": "error"
        },
        "operation": {
          "enum": [
            "report",
            "port",
            "matrix"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "path": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "errno": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "operation",
        "target",
        "operation_complete",
        "status",
        "reason",
        "failures",
        "effects_applied",
        "effects_durable",
        "files_preserved",
        "reports_observed",
        "source_bytes",
        "atomic_batch"
      ],
      "properties": {
        "record": {
          "const": "summary"
        },
        "operation": {
          "enum": [
            "report",
            "port",
            "matrix"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "operation_complete": {
          "type": "boolean"
        },
        "status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "failures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "effects_applied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "effects_durable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "files_preserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "reports_observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "atomic_batch": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation_complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              },
              "failures": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  }
}
