                  "type": "null"
                }
              ]
            },
            "delta": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "saved_tokens_estimated",
                "commands_predicted",
                "suggestions_offered",
                "suggestions_accepted",
                "guard_blocks",
                "naive_input_tokens_estimated",
                "jash_input_tokens_estimated"
