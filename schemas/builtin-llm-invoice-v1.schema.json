{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:semantic:llm-invoice:v1",
  "title": "Jash llm-invoice semantic result v1",
  "description": "Actual persisted session and lifetime counters. Token quantities are estimates; clock values are monotonic, not Unix timestamps. Multi-file writes are not atomic. JSON and JSON projection of the JTV2 record share this field contract. Native kinds additionally preserve PATH/SYMBOL/FILESIZE and exact I64/U64. The terminal is a separate JTV2 contract; this document alone does not prove stream completion.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "ok",
        "changed",
        "scope",
        "token_estimator",
        "lifetime",
        "session",
        "error",
        "effects_may_have_applied",
        "persisted"
      ],
      "properties": {
        "schema": {
          "const": "jash.llm-invoice.v1"
        },
        "operation": {
          "enum": [
            "status",
            "begin",
            "close",
            "reset"
          ]
        },
        "ok": {
