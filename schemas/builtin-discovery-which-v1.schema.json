{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:discovery:which:v1",
  "title": "which semantic query report",
  "description": "complete describes collection of all requested observations; status and per-item errors describe the operation outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "complete",
    "status",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "jash.discovery.v1"
    },
    "command": {
      "const": "which"
    },
    "complete": {
      "const": true
    },
    "status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "items": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "found",
          "value",
          "path",
          "summary",
          "executable",
          "error"
        ],
        "properties": {
          "name": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              }
            ]
          },
          "kind": {
            "enum": [
              "alias",
              "function",
              "builtin",
              "file",
              "missing"
            ]
          },
          "found": {
            "type": "boolean"
          },
          "value": {
            "oneOf": [
              {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64"
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "oneOf": [
              {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64"
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "oneOf": [
              {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64"
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "executable": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "error": {
            "enum": [
              "not_found",
              "name_too_long",
              null
            ]
          }
        }
      }
    }
  }
}
