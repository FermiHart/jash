{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:handoff:v1",
  "title": "Session handoff from checked retained records and fixed Git observations",
  "description": "No instruction is executed from recorded commands. Failure shapes and sampled filesystem changes are observations, not proof of causation. Session filename normalization is explicitly lossy where applicable. Git errors remain unavailable/failed rather than clean. Both result lists use the same requested offset and independent next offsets.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "session_id",
        "session_key",
        "session_identity_lossy",
        "commands_source",
        "fs_source",
        "files_scope",
        "git",
        "commands_total",
        "failed_commands",
        "first_timestamp",
        "last_timestamp",
        "failures",
        "files",
        "failure_groups_total",
        "files_total",
        "offset",
        "next_failure_offset",
        "next_file_offset",
        "truncated",
        "failure_grouping",
        "causation_established",
        "error",
        "errno"
      ],
      "properties": {
        "schema": {
          "const": "jash.handoff.v1"
        },
        "session_id": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "session_key": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "session_identity_lossy": {
          "type": "boolean"
        },
        "commands_source": {
          "$ref": "#/$defs/commands_source"
        },
        "fs_source": {
          "$ref": "#/$defs/fs_source"
        },
        "files_scope": {
          "enum": [
            "exact_session_field",
            "all_retained_sessions"
          ]
        },
        "git": {
          "anyOf": [
            {
              "$ref": "#/$defs/git"
            },
            {
              "type": "null"
            }
          ]
        },
        "commands_total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "failed_commands": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "first_timestamp": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "last_timestamp": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          },
          "maxItems": 256
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fs_entry"
          },
          "maxItems": 256
        },
        "failure_groups_total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "files_total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "next_failure_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "next_file_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "failure_grouping": {
          "const": "first_two_whitespace_delimited_words_heuristic"
        },
        "causation_established": {
          "const": false
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.handoff.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.handoff.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ],
  "$defs": {
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "fs_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "present",
        "read_complete",
        "bytes",
        "records",
        "coverage",
        "path_fidelity",
        "error",
        "errno"
      ],
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "present": {
          "type": "boolean"
        },
        "read_complete": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "coverage": {
          "const": "retained_sampled_changes_only"
        },
        "path_fidelity": {
          "const": "recorded_bytes_without_escaping"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "fs_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_seconds",
        "source_line",
        "session",
        "kind",
        "path_recorded"
      ],
      "properties": {
        "timestamp_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "source_line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "session": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "kind": {
          "enum": [
            "+",
            "~",
            "-"
          ]
        },
        "path_recorded": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        }
      }
    },
    "commands_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "present",
        "selected",
        "read_complete",
        "bytes",
        "records",
        "record_fidelity",
        "error",
        "errno"
      ],
      "properties": {
        "path": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "present": {
          "type": "boolean"
        },
        "selected": {
          "type": "boolean"
        },
        "read_complete": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "record_fidelity": {
          "const": "legacy_unescaped_line_writer_may_truncate_at_2040_bytes"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape_recorded",
        "count",
        "last_status",
        "last_timestamp",
        "last_command_recorded",
        "last_record_maybe_truncated"
      ],
      "properties": {
        "shape_recorded": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "last_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "last_timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "last_command_recorded": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "last_record_maybe_truncated": {
          "type": "boolean"
        }
      }
    },
    "git_status_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "git"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "index_status",
              "path"
            ],
            "properties": {
              "status": {
                "type": "string"
              },
              "index_status": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/bytes"
                  }
                ]
              },
              "original_path": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/bytes"
                  }
                ]
              }
            }
          },
          "maxItems": 512
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "branch",
            "dirty",
            "ahead",
            "behind"
          ],
          "properties": {
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            "dirty": {
              "type": "boolean"
            },
            "ahead": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "behind": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        }
      }
    },
    "git_log_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commits"
      ],
      "properties": {
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hash",
              "message",
              "author",
              "date"
            ],
            "properties": {
              "hash": {
                "type": "string",
                "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
              },
              "message": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/bytes"
                  }
                ]
              },
              "author": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/bytes"
                  }
                ]
              },
              "date": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/bytes"
                  }
                ]
              }
            }
          },
          "maxItems": 1
        }
      }
    },
    "git_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "started",
        "command_status",
        "adapter_status",
        "output_bytes",
        "truncated",
        "payload",
        "diagnostic_bytes"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "started": {
          "type": "boolean"
        },
        "command_status": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "adapter_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "truncated": {
          "type": "boolean"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/git_status_payload"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/bytes"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "git_log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "started",
        "command_status",
        "adapter_status",
        "output_bytes",
        "truncated",
        "payload",
        "diagnostic_bytes"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "started": {
          "type": "boolean"
        },
        "command_status": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "adapter_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "truncated": {
          "type": "boolean"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/git_log_payload"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/bytes"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "latest_commit",
        "latest_commit_requested",
        "cryptographically_verified",
        "consistency"
      ],
      "properties": {
        "schema": {
          "const": "jash.git-observation.v1"
        },
        "status": {
          "$ref": "#/$defs/git_status"
        },
        "latest_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/git_log"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_commit_requested": {
          "type": "boolean"
        },
        "cryptographically_verified": {
          "const": false
        },
        "consistency": {
          "const": "independent-subprocess-observations"
        }
      }
    }
  }
}
