{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:query:wc-array:v1",
  "title": "wc --json selected counter array",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name"
    ],
    "properties": {
      "name": {
        "$ref": "#/$defs/text"
      },
      "lines": {
        "$ref": "#/$defs/uint"
      },
      "words": {
        "$ref": "#/$defs/uint"
      },
      "bytes": {
        "$ref": "#/$defs/uint"
      },
      "chars": {
        "$ref": "#/$defs/uint"
      },
      "max_line_length": {
        "$ref": "#/$defs/uint"
      }
    },
    "anyOf": [
      {
        "required": [
          "lines"
        ]
      },
      {
        "required": [
          "words"
        ]
      },
      {
        "required": [
          "bytes"
        ]
      },
      {
        "required": [
          "chars"
        ]
      },
      {
        "required": [
          "max_line_length"
        ]
      }
    ],
    "not": {
      "required": [
        "bytes",
        "chars"
      ]
    }
  },
  "$defs": {
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/bytes"
        }
      ]
    },
    "uint": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      ]
    },
    "sint": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$"
        }
      ]
    }
  },
  "$comment": "Columns follow -l/-w/-c/-m/-L. The last -c/-m wins. Multiple operands append a total row. Legacy open failures use status/stderr and omit the failed row; --json-report and native modes retain explicit observation errors."
}
