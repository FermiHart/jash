{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:trash:v1",
  "description": "Semantic trash observations and action receipts. complete describes receipt collection; status and per-item errors describe operation success. applied=null means the transactional engine failed and effects may have occurred. Metadata retains the legacy directory line and records exact basename bytes in a versioned hexadecimal second line. Ambiguous legacy numeric prefixes never produce an invented original path. Queries expose live consistency and scan limits; actual move/restore/policy admit output before effects and flush each action before the next.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "complete",
    "status",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "jash.trash.v1"
    },
    "command": {
      "const": "trash"
    },
    "complete": {
      "type": "boolean"
    },
    "status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "items": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record",
              "entry",
              "path",
              "original_path",
              "name_source",
              "kind",
              "size",
              "mtime_seconds",
              "ttl_seconds",
              "error"
            ],
            "properties": {
              "record": {
                "const": "entry"
              },
              "entry": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64"
                      }
                    }
                  }
                ]
              },
              "path": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64"
                      }
                    }
                  }
                ]
              },
              "original_path": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name_source": {
                "enum": [
                  "metadata",
                  "legacy_single_prefix",
                  "unavailable"
                ]
              },
              "kind": {
                "enum": [
                  "regular",
                  "directory",
                  "symlink",
                  "other",
                  null
                ]
              },
              "size": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "mtime_seconds": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "ttl_seconds": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record",
              "operation",
              "source",
              "destination",
              "entry",
              "dry_run",
              "applied",
              "durable",
              "error",
              "errno"
            ],
            "properties": {
              "record": {
                "const": "action"
              },
              "operation": {
                "enum": [
                  "move",
                  "restore"
                ]
              },
              "source": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "destination": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "entry": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dry_run": {
                "type": "boolean"
              },
              "applied": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "durable": {
                "type": "boolean"
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "errno": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record",
              "operation",
              "protected",
              "source",
              "changed"
            ],
            "properties": {
              "record": {
                "const": "policy"
              },
              "operation": {
                "enum": [
                  "status",
                  "on",
                  "off",
                  "protect",
                  "auto",
                  "default"
                ]
              },
              "protected": {
                "type": "boolean"
              },
              "source": {
                "enum": [
                  "explicit",
                  "environment",
                  "recording_default"
                ]
              },
              "changed": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record",
              "operation",
              "entries",
              "bytes",
              "completed",
              "scan_complete",
              "consistency",
              "error"
            ],
            "properties": {
              "record": {
                "const": "summary"
              },
              "operation": {
                "enum": [
                  "move",
                  "restore",
                  "list",
                  "info"
                ]
              },
              "entries": {
                "type": "integer",
                "minimum": 0
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "completed": {
                "type": "integer",
                "minimum": 0
              },
              "scan_complete": {
                "type": "boolean"
              },
              "consistency": {
                "const": "live"
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        ]
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "effects_may_have_applied"
      ],
      "properties": {
        "code": {
          "const": "collection_limit_exceeded"
        },
        "effects_may_have_applied": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "status": {
            "const": 75
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
