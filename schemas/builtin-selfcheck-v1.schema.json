{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:selfcheck:v1",
  "title": "Jash selfcheck structured contract",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "algorithm",
        "binary",
        "binary_size",
        "current_hash",
        "baseline",
        "baseline_available_before",
        "expected_hash_before",
        "verified",
        "baseline_published",
        "durable",
        "directory_created",
        "baseline_error",
        "complete",
        "error",
        "errno",
        "exit_code"
      ],
      "properties": {
        "schema": {
          "const": "jash.selfcheck.v1"
        },
        "operation": {
          "enum": [
            "verify",
            "store",
            "force"
          ]
        },
        "algorithm": {
          "const": "sha256"
        },
        "binary": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "encoding",
                    "data"
                  ],
                  "properties": {
                    "encoding": {
                      "const": "base64"
                    },
                    "data": {
                      "type": "string",
                      "contentEncoding": "base64",
                      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "binary_size": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "current_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "encoding",
                    "data"
                  ],
                  "properties": {
                    "encoding": {
                      "const": "base64"
                    },
                    "data": {
                      "type": "string",
                      "contentEncoding": "base64",
                      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_available_before": {
          "type": "boolean"
        },
        "expected_hash_before": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_published": {
          "type": "boolean"
        },
        "durable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "directory_created": {
          "type": "boolean"
        },
        "baseline_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "type": "integer"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.selfcheck.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.selfcheck.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer"
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ],
  "$comment": "A matching digest verifies the running binary against the observed baseline only. A missing baseline is explicitly unavailable. Store/force preserve the interactive non-agent approval boundary."
}
