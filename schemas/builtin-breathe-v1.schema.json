{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:breathe:v1",
  "title": "Jash breathe structured contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "count",
    "tracked",
    "baseline",
    "too_soon",
    "elapsed_s",
    "interval_s",
    "threshold_ticks",
    "stuck",
    "procs",
    "pid",
    "ok",
    "applied",
    "durable",
    "signal",
    "identity",
    "error",
    "errno"
  ],
  "properties": {
    "schema": {
      "const": "jash.breathe.v1"
    },
    "operation": {
      "enum": [
        "status",
        "check",
        "kill"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "tracked": {
      "type": "integer",
      "minimum": 0
    },
    "baseline": {
      "type": "boolean"
    },
    "too_soon": {
      "type": "boolean"
    },
    "elapsed_s": {
      "type": "integer"
    },
    "interval_s": {
      "type": "integer",
      "minimum": 0
    },
    "threshold_ticks": {
      "type": "integer",
      "minimum": 0
    },
    "stuck": {
      "type": "integer",
      "minimum": 0
    },
    "procs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pid",
          "ppid",
          "uid",
          "user",
          "comm",
          "state",
          "rss_kb",
          "vsz_kb",
          "cpu_ticks",
          "start_ticks",
          "delta_ticks"
        ],
        "properties": {
          "pid": {
            "type": "integer",
            "minimum": 0
          },
          "ppid": {
            "type": "integer",
            "minimum": 0
          },
          "uid": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "user": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "comm": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  }
                }
              }
            ]
          },
          "state": {
            "type": "string"
          },
          "rss_kb": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "vsz_kb": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "cpu_ticks": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "start_ticks": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "delta_ticks": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "maxItems": 4096
    },
    "pid": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "applied": {
      "type": "boolean"
    },
    "durable": {
      "type": "boolean"
    },
    "signal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "const": "pid-and-start-ticks",
      "description": "Sampling/comparison label: check matches PID and process start ticks between samples. The shared label also appears in status and kill records and does not establish pinned signal identity. kill observes process ownership and protected-PID rules, then calls sys_kill(PID) without a pidfd. An accepted signal does not prove process exit."
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "errno": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
