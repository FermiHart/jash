{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:blame-file:v1",
  "description": "Retained timeline path observations and the nearest recorded command within ten seconds. Temporal proximity does not establish authorship, cryptographic validity, or recoverability. The timeline ring is bounded to128 and its lost counter is reported. Chain reads fail visibly on malformed/truncated input.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "entries",
        "matched",
        "offset",
        "next_offset",
        "truncated",
        "timeline_lost",
        "history_scope",
        "chain_source",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.blame-file.v1"
        },
        "path": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "entries": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "inverse_kind",
              "recorded_description",
              "timestamp",
              "path_a",
              "path_b",
              "nearest_command",
              "candidate_count",
              "delta_seconds",
              "attribution",
              "restoration_assessed"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "inverse_kind": {
                "type": "string"
              },
              "recorded_description": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/bytes"
                  }
                ]
              },
              "timestamp": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "path_a": {
                "oneOf": [
                  {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/bytes"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "path_b": {
                "oneOf": [
                  {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/bytes"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "nearest_command": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/chain_entry"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "candidate_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "delta_seconds": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "attribution": {
                "const": "temporal_proximity_not_proof"
              },
              "restoration_assessed": {
                "const": false
              }
            }
          }
        },
        "matched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "next_offset": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "timeline_lost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "history_scope": {
          "const": "retained_timeline_ring_max_128"
        },
        "chain_source": {
          "$ref": "#/$defs/chain_source"
        },
        "error": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.blame-file.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.blame-file.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ],
  "$defs": {
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "chain_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "timestamp_seconds",
        "timestamp_nanoseconds",
        "source_line",
        "status",
        "hash_recorded",
        "tag",
        "command_recorded",
        "cwd_recorded",
        "repo",
        "session",
        "duration_ms"
      ],
      "properties": {
        "sequence": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "timestamp_nanoseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "hash_recorded": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tag": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "command_recorded": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "cwd_recorded": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "repo": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "chain_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "present",
        "read_complete",
        "bytes",
        "records",
        "session_markers",
        "cryptographically_verified",
        "command_fidelity",
        "cwd_fidelity",
        "error",
        "errno"
      ],
      "properties": {
        "path": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "present": {
          "type": "boolean"
        },
        "read_complete": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "session_markers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "cryptographically_verified": {
          "const": false
        },
        "command_fidelity": {
          "const": "recorded_bytes_only"
        },
        "cwd_fidelity": {
          "const": "legacy_may_replace_spaces_with_underscores"
        },
        "error": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
