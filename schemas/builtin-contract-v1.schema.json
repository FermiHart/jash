{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:contract:v1",
  "title": "Observed literal command execution and output predicates",
  "description": "Actual execvp argv, separate captured byte channels, checked exec/wait/capture outcomes. Each channel retains at most --capture-bytes (default/max256KiB). Both channels are drained concurrently. Exceeding capture bounds fails without asserting absent output. A fully evaluated false contract is status2/JTV2 COMPLETE/errors0; source/launch/capture failures are FAILED. JSON admission reserves worst-case capture before execution. The command may have effects before output overflows. Regex predicates reject binary-NUL output explicitly.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "argv",
        "execution_scope",
        "execution",
        "expectations",
        "complete",
        "matched",
        "predicate_status",
        "error",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.contract.v1"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  }
                }
              }
            ]
          }
        },
        "execution_scope": {
          "const": "external_literal_argv"
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempted",
            "command_status",
            "stdout",
            "stderr",
            "stdout_bytes_seen",
            "stderr_bytes_seen",
            "stdout_truncated",
            "stderr_truncated",
            "complete",
            "capture_boundary",
            "adapter_errno",
            "writer_errno",
            "restore_errno"
          ],
          "properties": {
            "attempted": {
              "type": "boolean"
            },
            "command_status": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "null"
                }
              ]
            },
            "stdout": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "data"
              ],
              "properties": {
                "encoding": {
                  "const": "base64"
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            },
            "stderr": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "data"
              ],
              "properties": {
                "encoding": {
                  "const": "base64"
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            },
            "stdout_bytes_seen": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "stderr_bytes_seen": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "stdout_truncated": {
              "type": "boolean"
            },
            "stderr_truncated": {
              "type": "boolean"
            },
            "complete": {
              "type": "boolean"
            },
            "capture_boundary": {
              "const": "evaluation_return_background_output_not_waited"
            },
            "adapter_errno": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "null"
                }
              ]
            },
            "writer_errno": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "null"
                }
              ]
            },
            "restore_errno": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "stdout_truncated": {
                    "const": false
                  },
                  "stderr_truncated": {
                    "const": false
                  },
                  "adapter_errno": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "attempted": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "command_status": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "expectations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "expected",
              "evaluated",
              "passed"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "rc",
                  "stdout-contains",
                  "stdout-empty",
                  "stdout-matches",
                  "stderr-contains",
                  "stderr-empty"
                ]
              },
              "expected": {
                "anyOf": [
                  {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "encoding",
                          "data"
                        ],
                        "properties": {
                          "encoding": {
                            "const": "base64"
                          },
                          "data": {
                            "type": "string",
                            "contentEncoding": "base64",
                            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  {
                    "type": "null"
