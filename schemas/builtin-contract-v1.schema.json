                ]
              },
              "evaluated": {
                "type": "boolean"
              },
              "passed": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "evaluated": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "passed": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "rc"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "expected": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "stdout-empty",
                        "stderr-empty"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "expected": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "stdout-contains",
                        "stdout-matches",
                        "stderr-contains"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "expected": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "encoding",
                            "data"
                          ],
                          "properties": {
                            "encoding": {
                              "const": "base64"
                            },
                            "data": {
                              "type": "string",
                              "contentEncoding": "base64",
                              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "complete": {
          "type": "boolean"
        },
        "matched": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "predicate_status": {
          "enum": [
            null,
            0,
            2
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              },
              "matched": {
                "type": "boolean"
              },
              "predicate_status": {
                "enum": [
                  0,
                  2
                ]
              },
              "execution": {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "matched": {
                "type": "null"
              },
              "predicate_status": {
                "type": "null"
              },
              "error": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "matched": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "predicate_status": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "matched": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "predicate_status": {
                "const": 2
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.contract.v1"
        },
        "ok": {
          "const": false
