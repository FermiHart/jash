{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:xargs-plan:v1",
  "title": "Jash xargs-plan v1",
  "description": "An explicit --plan or --dry-run returns this JSON array without executing a child. Native mode emits one row per planned invocation; each row follows urn:jash:xargs-plan:row:v1. Exact argv preserves empty strings and byte arguments.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "argv"
    ],
    "properties": {
      "argv": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "data"
              ],
              "properties": {
                "encoding": {
                  "const": "base64"
                },
                "data": {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            }
          ]
        },
        "maxItems": 65536,
        "minItems": 1
      }
    }
  },
  "maxItems": 65536
}
