{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:xargs-plan:row:v1",
  "title": "Jash xargs-plan-row v1",
  "description": "JSON document and JSON projection of native JTV2 share the declared fields. Native kinds, logical credits, framing and authoritative terminal are verified separately; a JSON projection cannot establish those properties. A single effect-free planned invocation; this shape is not an execution receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "argv"
  ],
  "properties": {
    "argv": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "encoding",
              "data"
            ],
            "properties": {
              "encoding": {
                "const": "base64"
              },
              "data": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              }
            }
          }
        ]
      },
      "maxItems": 65536,
      "minItems": 1
    }
  }
}
