{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:kill:v1",
  "title": "Jash kill structured contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "items",
    "complete",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "jash.kill.v1"
    },
    "command": {
      "const": "kill"
    },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "signal",
              "name"
            ],
            "properties": {
              "kind": {
                "const": "signal"
              },
              "signal": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "pid",
              "comm",
              "signal",
              "preview",
              "sent",
              "errno",
              "error"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "pid": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "comm": {
                "anyOf": [
                  {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "encoding",
                          "data"
                        ],
                        "properties": {
                          "encoding": {
                            "const": "base64"
                          },
                          "data": {
                            "type": "string",
                            "contentEncoding": "base64",
                            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "signal": {
                "type": "integer",
                "minimum": 0
              },
              "preview": {
                "type": "boolean"
              },
              "sent": {
                "type": "boolean"
              },
              "errno": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "anyOf": [
                  {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "encoding",
                          "data"
                        ],
                        "properties": {
                          "encoding": {
                            "const": "base64"
                          },
                          "data": {
                            "type": "string",
                            "contentEncoding": "base64",
                            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        ]
      },
      "maxItems": 4096
    },
    "complete": {
      "type": "boolean"
    },
    "status": {
      "type": "integer"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "effects_may_have_applied"
      ],
      "properties": {
        "code": {
          "const": "collection_limit_exceeded"
        },
        "effects_may_have_applied": {
          "const": true
        }
      }
    }
  }
}
