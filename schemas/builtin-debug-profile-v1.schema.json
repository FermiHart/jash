{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:debug:profile:v1",
  "title": "Incremental debug profiler receipts",
  "description": "One header, one checked receipt per attempted statement, then a summary. JSONL or JTV2. Command stdout and stderr go to stderr and are not reinterpreted as semantic values. Commands run in the current shell. Replacing/terminating the shell may leave an incomplete stream, which consumers must reject. Source and all possible receipt sizes are checked before effects; a sink failure stops before the next statement.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "path",
        "source_bytes",
        "statements_total",
        "source_consistency",
        "grouping",
        "execution_scope",
        "command_output_destination"
      ],
      "properties": {
        "schema": {
          "const": "jash.debug.profile.v1"
        },
        "kind": {
          "const": "header"
        },
        "path": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "data"
              ],
              "properties": {
                "encoding": {
                  "const": "base64"
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            }
          ]
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "statements_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "source_consistency": {
          "const": "named_file_metadata_before_and_after"
        },
        "grouping": {
          "const": "registered_debug_block_heuristic"
        },
        "execution_scope": {
          "const": "current_shell_state"
        },
        "command_output_destination": {
          "const": "stderr"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "index",
        "first_line",
        "last_line",
        "command",
        "attempted",
        "command_status",
        "duration_ns",
        "clock_errno",
        "adapter_errno",
        "writer_errno",
        "restore_errno"
      ],
      "properties": {
        "schema": {
          "const": "jash.debug.profile.v1"
        },
        "kind": {
          "const": "statement"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "first_line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "last_line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "command": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "data"
              ],
              "properties": {
                "encoding": {
                  "const": "base64"
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            }
          ]
        },
        "attempted": {
          "type": "boolean"
        },
        "command_status": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "clock_errno": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "adapter_errno": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "writer_errno": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "restore_errno": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "attempted": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "command_status": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "clock_errno": {
                "type": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "duration_ns": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "executed",
        "failed_commands",
        "complete",
        "shell_control_requested",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.debug.profile.v1"
        },
        "kind": {
          "const": "summary"
        },
        "executed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "failed_commands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "complete": {
          "type": "boolean"
        },
        "shell_control_requested": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.debug.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      }
    }
  ]
}
