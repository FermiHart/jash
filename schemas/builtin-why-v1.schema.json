{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:why:v1",
  "description": "Observed last-status state plus exact drift-key lookup for the recorded command at the current cwd. A ledger timestamp belongs to a cached successful fingerprint; it does not establish the most recent successful execution or causation. The fixed state command buffer can contain a prefix only. Historical JSON keys remain aliases of these same facts in JSON and native data. The legacy last_ok_ts zero sentinel means no successfully observed cached timestamp, not proof that the command never succeeded.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "known",
        "command_recorded",
        "status",
        "message_recorded",
        "command_capacity_bytes",
        "command_may_be_truncated",
        "lookup_cwd",
        "lookup_scope",
        "success_fingerprint_timestamp",
        "timestamp_semantics",
        "mutations_recorded",
        "causation_established",
        "error",
        "errno",
        "cmd",
        "rc",
        "msg",
        "mutations_this_session",
        "last_ok_ts",
        "reason",
        "verdict"
      ],
      "properties": {
        "schema": {
          "const": "jash.why.v1"
        },
        "known": {
          "type": "boolean"
        },
        "command_recorded": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "message_recorded": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "command_capacity_bytes": {
          "const": 255
        },
        "command_may_be_truncated": {
          "type": "boolean"
        },
        "lookup_cwd": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "lookup_scope": {
          "const": "recorded_command_at_current_cwd"
        },
        "success_fingerprint_timestamp": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp_semantics": {
          "const": "cached_success_fingerprint_not_latest_execution"
        },
        "mutations_recorded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "causation_established": {
          "const": false
        },
        "error": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cmd": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Historical JSON alias of command_recorded from the same observation."
        },
        "rc": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ],
          "description": "Historical JSON alias of status from the same observation."
        },
        "msg": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Historical JSON alias of message_recorded from the same observation."
        },
        "mutations_this_session": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128,
          "description": "Historical JSON alias of mutations_recorded from the same observation."
        },
        "last_ok_ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "Historical sentinel: zero means no successfully observed cached timestamp; otherwise equals success_fingerprint_timestamp. It does not establish the latest successful execution."
        },
        "reason": {
          "oneOf": [
            {
              "const": "no last command recorded"
            },
            {
              "type": "null"
            }
          ],
          "description": "Historical no-command explanation; null when a command was recorded."
        },
        "verdict": {
          "oneOf": [
            {
              "const": "ok"
            },
            {
              "type": "null"
            }
          ],
          "description": "Historical success label for a known recorded status of zero; not a claim that the drift lookup succeeded."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.why.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.why.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ],
  "$defs": {
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "chain_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "timestamp_seconds",
        "timestamp_nanoseconds",
        "source_line",
        "status",
        "hash_recorded",
        "tag",
        "command_recorded",
        "cwd_recorded",
        "repo",
        "session",
        "duration_ms"
      ],
      "properties": {
        "sequence": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "timestamp_nanoseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "hash_recorded": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tag": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "command_recorded": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "cwd_recorded": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "repo": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "chain_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "present",
        "read_complete",
        "bytes",
        "records",
        "session_markers",
        "cryptographically_verified",
        "command_fidelity",
        "cwd_fidelity",
        "error",
        "errno"
      ],
      "properties": {
        "path": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "present": {
          "type": "boolean"
        },
        "read_complete": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "session_markers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "cryptographically_verified": {
          "const": false
        },
        "command_fidelity": {
          "const": "recorded_bytes_only"
        },
        "cwd_fidelity": {
          "const": "legacy_may_replace_spaces_with_underscores"
        },
        "error": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
