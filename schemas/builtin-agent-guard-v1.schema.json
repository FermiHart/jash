{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:semantic:agent-guard:v1",
  "title": "Jash agent-guard semantic result v1",
  "description": "Actual policy state and home-cumulative guard counters; failure to persist is explicit. JSON and JSON projection of the JTV2 record share this field contract. Native kinds additionally preserve PATH/SYMBOL/FILESIZE and exact I64/U64. The terminal is a separate JTV2 contract; this document alone does not prove stream completion.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "ok",
        "changed",
        "error",
        "total",
        "native",
        "bypass",
        "blocked",
        "upgraded",
        "pct",
        "metrics_scope",
        "monitoring",
        "strict",
        "effects_may_have_applied",
        "persisted"
      ],
      "properties": {
        "schema": {
          "const": "jash.agent-guard.v1"
        },
        "operation": {
          "enum": [
            "status",
            "off",
            "on",
            "relaxed",
            "strict"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "changed": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "native": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "bypass": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "blocked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "upgraded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "pct": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics_scope": {
          "const": "home-cumulative"
        },
        "monitoring": {
          "type": "boolean"
        },
        "strict": {
          "type": "boolean"
        },
        "effects_may_have_applied": {
          "type": "boolean"
        },
        "persisted": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.agent-guard.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.agent-guard.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ]
}
