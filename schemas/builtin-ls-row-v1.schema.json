{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:query:ls-row:v1",
  "title": "One ls --json JSONL row; stream status is out of band",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "path",
    "type",
    "size",
    "mode",
    "mtime"
  ],
  "properties": {
    "name": {
      "$ref": "#/$defs/byteString"
    },
    "path": {
      "$ref": "#/$defs/byteString"
    },
    "type": {
      "enum": [
        "missing",
        "dir",
        "symlink",
        "file",
        "other"
      ]
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10
    },
    "mtime": {
      "type": "integer"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "errno"
      ],
      "properties": {
        "operation": {
          "enum": [
            "unstable",
            "readlink",
            "metadata"
          ]
        },
        "errno": {
          "type": "integer"
        }
      }
    }
  },
  "$defs": {
    "byteString": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "data"
          ],
          "properties": {
            "encoding": {
              "const": "base64"
            },
            "data": {
              "type": "string",
              "contentEncoding": "base64"
            }
          }
        }
      ]
    }
  }
}
