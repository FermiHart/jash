{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:lint:v1",
  "title": "Registered lint rules with complete collection and explicit predicate outcomes",
  "description": "A completed analysis with warnings/errors has predicate_status 1 and JTV2 COMPLETE/errors_seen 0. File, resource or argument failures are separate. Diagnostics are line patterns, not proof of shell program behavior. Column 1 is the rule location convention; source bytes are not silently truncated.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source",
        "complete",
        "lint",
        "diagnostics_returned",
        "total",
        "counts",
        "predicate_status",
        "analysis_scope",
        "column_basis",
        "error",
        "errno"
      ],
      "properties": {
        "schema": {
          "const": "jash.lint.v1"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "read_complete",
            "bytes",
            "lines_scanned",
            "consistency"
          ],
          "properties": {
            "kind": {
              "enum": [
                "inline",
                "file"
              ]
            },
            "path": {
              "anyOf": [
                {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "encoding",
                        "data"
                      ],
                      "properties": {
                        "encoding": {
                          "const": "base64"
                        },
                        "data": {
                          "type": "string",
                          "contentEncoding": "base64",
                          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "read_complete": {
              "type": "boolean"
            },
            "bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                {
                  "type": "null"
                }
              ]
            },
            "lines_scanned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "consistency": {
              "enum": [
                "literal_argv",
                "named_file_metadata_before_and_after"
              ]
            }
          }
        },
        "complete": {
          "type": "boolean"
        },
        "lint": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "col",
              "severity",
              "rule_id",
              "message",
              "fix_hint"
            ],
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              },
              "col": {
                "const": 1
              },
              "severity": {
                "enum": [
                  "error",
                  "warning",
                  "style",
                  "info"
                ]
              },
              "rule_id": {
                "type": "string"
              },
              "message": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              },
              "fix_hint": {
                "anyOf": [
                  {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "encoding",
                          "data"
                        ],
                        "properties": {
                          "encoding": {
                            "const": "base64"
                          },
                          "data": {
                            "type": "string",
                            "contentEncoding": "base64",
                            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 1024
        },
        "diagnostics_returned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "errors",
            "warnings",
            "style",
            "info"
          ],
          "properties": {
            "errors": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "warnings": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "style": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "info": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        "predicate_status": {
          "enum": [
            null,
            0,
            1
          ]
        },
        "analysis_scope": {
          "const": "registered_line_pattern_rules_not_full_shell_semantics"
        },
        "column_basis": {
          "const": "rule_reports_line_start"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "predicate_status": {
                "enum": [
                  0,
                  1
                ]
              },
              "error": {
                "type": "null"
              },
              "errno": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "complete": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "total": {
                "type": "null"
              },
              "predicate_status": {
                "type": "null"
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.lint.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.lint.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ]
}
