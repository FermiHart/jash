{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:git-status:v1",
  "title": "Jash git-status v1",
  "description": "JSON document and JSON projection of native JTV2 share the declared fields. Native kinds, logical credits, framing and authoritative terminal are verified separately; a JSON projection cannot establish those properties. Fixed git porcelain-v1 -z collection with raw path identity. Missing/unreadable/non-repository states are errors, never inferred clean. Payload is absent on capture/subprocess failure; the reduced failure receipt preserves observed child and adapter statuses.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rc",
        "command_status",
        "adapter_status",
        "ok",
        "argv",
        "output_bytes",
        "output_stream",
        "effects_may_have_applied",
        "error",
        "files",
        "git"
      ],
      "properties": {
        "schema": {
          "const": "jash.git-status.v1"
        },
        "rc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "command_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "adapter_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "ok": {
          "type": "boolean"
        },
        "argv": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  }
                }
              }
            ]
          },
          "maxItems": 72,
          "minItems": 1
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "output_stream": {
          "const": "combined-stdout-stderr"
        },
        "effects_may_have_applied": {
          "type": "boolean"
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "capture_or_parse_failed",
                "command_failed"
              ]
            }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "index_status",
              "path"
            ],
            "properties": {
              "status": {
                "enum": [
                  "untracked",
                  "unmerged",
                  "renamed",
                  "copied",
                  "added",
                  "deleted",
                  "modified",
                  "changed"
                ]
              },
              "index_status": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2
              },
              "path": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              },
              "original_path": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              }
            }
          },
          "maxItems": 512
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "branch",
            "dirty",
            "ahead",
            "behind"
          ],
          "properties": {
            "branch": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "encoding",
                        "data"
                      ],
                      "properties": {
                        "encoding": {
                          "const": "base64"
                        },
                        "data": {
                          "type": "string",
                          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "dirty": {
              "type": "boolean"
            },
            "ahead": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "behind": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "rc": {
                "const": 0
              },
              "command_status": {
                "const": 0
              },
              "adapter_status": {
                "const": 0
              },
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rc",
        "command_status",
        "adapter_status",
        "ok",
        "argv",
        "output_bytes",
        "output_stream",
        "effects_may_have_applied",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.git-status.v1"
        },
        "rc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "command_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "adapter_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "ok": {
          "const": false
        },
        "argv": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  }
                }
              }
            ]
          },
          "maxItems": 72,
          "minItems": 1
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "output_stream": {
          "const": "combined-stdout-stderr"
        },
        "effects_may_have_applied": {
          "type": "boolean"
        },
        "error": {
          "enum": [
            "capture_or_parse_failed",
            "command_failed"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rc",
        "command_status",
        "adapter_status",
        "ok",
        "output_bytes",
        "effects_may_have_applied",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.git-status.v1"
        },
        "rc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "command_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "adapter_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "ok": {
          "const": false
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "effects_may_have_applied": {
          "type": "boolean"
        },
        "error": {
          "const": "report_encoding_or_budget_failed"
        }
      }
    }
  ]
}
