{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:query:stat-array:v1",
  "title": "stat --json legacy successful observation array",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "type",
      "size",
      "mode",
      "perms",
      "nlink",
      "uid",
      "gid",
      "inode",
      "device",
      "mtime",
      "atime",
      "ctime",
      "mtime_nsec",
      "atime_nsec",
      "ctime_nsec"
    ],
    "properties": {
      "name": {
        "$ref": "#/$defs/text"
      },
      "type": {
        "enum": [
          "file",
          "dir",
          "symlink",
          "block",
          "char",
          "fifo",
          "socket",
          "unknown"
        ]
      },
      "size": {
        "$ref": "#/$defs/sint"
      },
      "mode": {
        "type": "string",
        "pattern": "^[0-7]{4}$"
      },
      "perms": {
        "type": "string",
        "pattern": "^[r-][w-][x-][r-][w-][x-][r-][w-][x-]$"
      },
      "nlink": {
        "$ref": "#/$defs/uint"
      },
      "uid": {
        "$ref": "#/$defs/uint"
      },
      "gid": {
        "$ref": "#/$defs/uint"
      },
      "inode": {
        "$ref": "#/$defs/uint"
      },
      "device": {
        "$ref": "#/$defs/uint"
      },
      "mtime": {
        "$ref": "#/$defs/sint"
      },
      "atime": {
        "$ref": "#/$defs/sint"
      },
      "ctime": {
        "$ref": "#/$defs/sint"
      },
      "mtime_nsec": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999999999
      },
      "atime_nsec": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999999999
      },
      "ctime_nsec": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999999999
      },
      "target": {
        "anyOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "symlink"
            }
          }
        },
        "then": {
          "required": [
            "target"
          ]
        },
        "else": {
          "not": {
            "required": [
              "target"
            ]
          }
        }
      }
    ]
  },
  "$defs": {
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/bytes"
        }
      ]
    },
    "uint": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      ]
    },
    "sint": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$"
        }
      ]
    }
  },
  "$comment": "Missing operands are omitted with status1/stderr in this legacy mode. --json-report retains explicit error rows and paging; --data/--data-v2 use native schemas and terminal. This array cannot establish stream success by itself."
}
