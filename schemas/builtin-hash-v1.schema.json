{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:hash:v1",
  "title": "Jash hash native report v1",
  "description": "Reports the explicit builtin hash table. This is distinct from the executor PATH cache, which may be consulted by resolution. -r clears this explicit table only. Cache receipts do not claim a successful insertion when the table is full. Stateful operations admit a checked header before effects and flush each receipt before the next action. Mutation receipts bypass presentation budgets. Collection failure after admission retains prior receipts with complete:false, status:75 and effects_may_have_applied:true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "complete",
    "status",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "jash.hash.v1"
    },
    "command": {
      "enum": [
        "hash"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "items": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "name",
          "operation",
          "before",
          "path",
          "changed",
          "cleared",
          "ok",
          "error"
        ],
        "properties": {
          "scope": {
            "const": "builtin-hash-table"
          },
          "name": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "operation": {
            "enum": [
              "list",
              "cache",
              "clear"
            ]
          },
          "before": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "changed": {
            "type": "boolean"
          },
          "cleared": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "effects_may_have_applied"
      ],
      "properties": {
        "code": {
          "const": "collection_limit_exceeded"
        },
        "effects_may_have_applied": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "status": {
            "const": 75
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
