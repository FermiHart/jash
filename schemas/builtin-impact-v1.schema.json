    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "files",
        "sessions_source",
        "fs_source",
        "complete",
        "analysis_scope",
        "path_matching",
        "ordering",
        "window_seconds",
        "run_weight",
        "last_failing_test_success_bonus",
        "touches",
        "known_test_commands",
        "test_runs",
        "ranked_total",
        "cold",
        "recommendations",
        "offset",
        "next_offset",
        "truncated",
        "error",
        "errno"
      ],
