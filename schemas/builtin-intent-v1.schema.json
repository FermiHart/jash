{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:intent:v1",
  "description": "One-line intent from the actual environment and checked persistence. Values up to 511 bytes, no CR/LF. Native mutation publishes/removes the file before updating the environment; applied/durable and environment_applied expose partial phases. Environment takes precedence during reads.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "value",
        "persisted_value",
        "source",
        "applied",
        "durable",
        "environment_applied",
        "error",
        "errno"
      ],
      "properties": {
        "schema": {
          "const": "jash.intent.v1"
        },
        "operation": {
          "enum": [
            "get",
            "set",
            "clear"
          ]
        },
        "value": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 511
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "persisted_value": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 511
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "environment",
            "store",
            "absent"
          ]
        },
        "applied": {
          "type": "boolean"
        },
        "durable": {
          "type": "boolean"
        },
        "environment_applied": {
          "type": "boolean"
        },
        "error": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.intent.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.intent.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ],
  "$defs": {
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
