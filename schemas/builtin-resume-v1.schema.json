{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:resume:v1",
  "description": "A length-preserving bounded note and live observations at its saved cwd. Head comparison requires both observations to be known. Path extraction is heuristic and checks at most 16 tokens; mtime uses whole seconds. A non-stale result does not verify the truth of the note or uncited files. Mutation phases describe real atomic file publication/removal.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "note",
        "cwd",
        "written",
        "age_s",
        "head_then",
        "head_now",
        "head_moved",
        "stale",
        "files",
        "watching_truncated",
        "path_detection",
        "not_verified",
        "applied",
        "durable",
        "error",
        "errno"
      ],
      "properties": {
        "schema": {
          "const": "jash.resume.v1"
        },
        "operation": {
          "enum": [
            "get",
            "set",
            "forget"
          ]
        },
        "note": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 3999
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 4095
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "written": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "age_s": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "head_then": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 15
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "head_now": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 12
                },
                {
                  "$ref": "#/$defs/bytes"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "head_moved": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "resolved_path",
              "missing",
              "changed_since_note",
              "error",
              "errno"
            ],
            "properties": {
              "path": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 255
                  },
                  {
                    "$ref": "#/$defs/bytes"
                  }
                ]
              },
              "resolved_path": {
                "oneOf": [
                  {
                    "oneOf": [
                      {
                        "type": "string",
                        "maxLength": 4095
                      },
                      {
                        "$ref": "#/$defs/bytes"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "missing": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "changed_since_note": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "errno": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "watching_truncated": {
          "type": "boolean"
        },
        "path_detection": {
          "const": "heuristic_tokens_up_to_255_bytes"
        },
        "not_verified": {
          "type": "array",
          "minItems": 4,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "truth_of_note",
              "uncited_files",
              "same_second_content_changes",
              "complete_path_extraction",
              "git_head"
            ]
          }
        },
        "applied": {
          "type": "boolean"
        },
        "durable": {
          "type": "boolean"
        },
        "error": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.resume.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.resume.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ],
  "$defs": {
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
