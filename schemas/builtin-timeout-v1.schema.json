{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:timeout:v1",
  "title": "Jash timeout structured contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "exit_code",
    "child_exit_code",
    "started",
    "timed_out",
    "cancelled",
    "signal_sent",
    "duration_ms",
    "duration",
    "pid",
    "argv",
    "child_output_channel",
    "kill_incomplete",
    "error"
  ],
  "dependentRequired": {
    "where_available": ["where", "where_preview"],
    "where": ["where_available", "where_preview"],
    "where_preview": ["where_available", "where"]
  },
  "properties": {
    "schema": {
      "const": "jash.timeout.v1"
    },
    "exit_code": {
      "type": "integer"
    },
    "child_exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "started": {
      "type": "boolean"
    },
    "timed_out": {
      "type": "boolean"
    },
    "cancelled": {
      "type": "boolean"
    },
    "signal_sent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_ms": {
      "type": "integer"
    },
    "duration": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "pid": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "argv": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "encoding",
              "data"
            ],
            "properties": {
              "encoding": {
                "const": "base64"
              },
              "data": {
                "type": "string",
                "contentEncoding": "base64",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              }
            }
          }
        ]
      }
    },
    "child_output_channel": {
      "const": "stderr"
    },
    "kill_incomplete": {
      "type": "boolean"
    },
    "where_available": {
      "type": "boolean"
    },
    "where": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "data"],
          "properties": {
            "encoding": {
              "const": "base64"
            },
            "data": {
              "type": "string",
              "minLength": 4,
              "contentEncoding": "base64",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        }
      ]
    },
    "where_preview": {
      "const": true
    },
    "error": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "data"
              ],
              "properties": {
                "encoding": {
                  "const": "base64"
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$comment": "Duration is elapsed wall-clock milliseconds and its nanosecond projection; a negative wall-clock delta does not invent monotonic timing. Child streams go to stderr in structured mode. The where_available, where and where_preview fields are present together only when --diagnose was requested. Without --diagnose all three are absent, preserving the established JSON contract. Requested diagnostics always supply a nonempty observation or an explicit reason for unavailability, including when the deadline did not expire."
}
