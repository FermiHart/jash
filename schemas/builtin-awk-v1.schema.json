{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:query:awk:v1",
  "title": "awk --json owned AST result or explicit incomplete/error envelope",
  "oneOf": [
    {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fields"
            ],
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "$ref": "#/$defs/text"
                    }
                  ]
                },
                "maxItems": 8
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "$ref": "#/$defs/text"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              }
            }
          }
        ]
      },
      "maxItems": 4096
    },
    {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "$ref": "#/$defs/text"
                  }
                ]
              },
              "maxItems": 8
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result"
          ],
          "properties": {
            "result": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/text"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "complete",
        "reason",
        "numeric_model",
        "errors",
        "results"
      ],
      "properties": {
        "schema": {
          "const": "jash.awk.v1"
        },
        "complete": {
          "const": false
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "numeric_model": {
          "const": "binary64"
        },
        "errors": {
          "$ref": "#/$defs/uint"
        },
        "results": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fields"
                ],
                "properties": {
                  "fields": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/$defs/text"
                        }
                      ]
                    },
                    "maxItems": 8
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "result"
                ],
                "properties": {
                  "result": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "$ref": "#/$defs/text"
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "$ref": "#/$defs/text"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "complete",
                  "error",
                  "file"
                ],
                "properties": {
                  "complete": {
                    "const": false
                  },
                  "error": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "file": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/text"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "maxItems": 4096
        }
      }
    }
  ],
  "$defs": {
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/bytes"
        }
      ]
    },
    "uint": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      ]
    },
    "sint": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$"
        }
      ]
    }
  },
  "$comment": "Numeric evaluation is binary64. Finite fractional JSON numbers preserve 17 significant digits; integral values outside the safe integer range are decimal strings. A single aggregate output is an object; all other successful outputs form an array. Errors and incomplete pages always carry the jash.awk.v1 envelope. Native binary64 values also carry exact big-endian bits."
}
