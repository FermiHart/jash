{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:ps-row:v1",
  "title": "Jash ps-row structured contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pid",
    "ppid",
    "pgrp",
    "comm",
    "state",
    "uid",
    "rss_kb",
    "vsz_kb",
    "rss_bytes",
    "vsz_rounded_bytes",
    "threads",
    "cpu_ticks",
    "start_ticks",
    "ticks_per_second",
    "tty",
    "surface",
    "seat",
    "complete",
    "cache_revalidated",
    "scope",
    "memory_unit_bytes",
    "observed",
    "index"
  ],
  "properties": {
    "schema": {
      "const": "jash.process.v1"
    },
    "pid": {
      "type": "integer",
      "minimum": 0
    },
    "ppid": {
      "type": "integer",
      "minimum": 0
    },
    "pgrp": {
      "type": "integer"
    },
    "comm": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "data"
          ],
          "properties": {
            "encoding": {
              "const": "base64"
            },
            "data": {
              "type": "string",
              "contentEncoding": "base64",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        }
      ]
    },
    "state": {
      "type": "string"
    },
    "uid": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "rss_kb": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "vsz_kb": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "rss_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "vsz_rounded_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "threads": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "cpu_ticks": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "start_ticks": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "ticks_per_second": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "tty": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "data"
          ],
          "properties": {
            "encoding": {
              "const": "base64"
            },
            "data": {
              "type": "string",
              "contentEncoding": "base64",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        }
      ]
    },
    "surface": {
      "type": "integer"
    },
    "seat": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "data"
          ],
          "properties": {
            "encoding": {
              "const": "base64"
            },
            "data": {
              "type": "string",
              "contentEncoding": "base64",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        }
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "cache_revalidated": {
      "type": "boolean"
    },
    "scope": {
      "const": "readable-osif-processes"
    },
    "memory_unit_bytes": {
      "const": 1024
    },
    "observed": {
      "type": "integer",
      "minimum": 0
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$comment": "JSONL, one process per row. An empty result is zero rows. Native JTV2 reports page incompleteness in its authoritative terminal. No unavailable OSIF counter is replaced by zero."
}
