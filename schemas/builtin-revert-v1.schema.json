{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:revert:v1",
  "title": "Jash revert structured contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "items",
    "complete",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "jash.revert.action.v1"
    },
    "command": {
      "const": "revert"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "argv",
          "started",
          "pid",
          "exit_code",
          "signal",
          "errno",
          "error",
          "observation",
          "domain_state_verified",
          "effects_may_have_applied",
          "child_output"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "argv": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "encoding",
                    "data"
                  ],
                  "properties": {
                    "encoding": {
                      "const": "base64"
                    },
                    "data": {
                      "type": "string",
                      "contentEncoding": "base64",
                      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                    }
                  }
                }
              ]
            },
            "maxItems": 5
          },
          "started": {
            "type": "boolean"
          },
          "pid": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "exit_code": {
            "type": "integer"
          },
          "signal": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "errno": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "observation": {
            "const": "child_execution"
          },
          "domain_state_verified": {
            "const": false
          },
          "effects_may_have_applied": {
            "type": "boolean"
          },
          "child_output": {
            "const": "stderr"
          }
        }
      },
      "maxItems": 4096
    },
    "complete": {
      "type": "boolean"
    },
    "status": {
      "type": "integer"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "effects_may_have_applied"
      ],
      "properties": {
        "code": {
          "const": "collection_limit_exceeded"
        },
        "effects_may_have_applied": {
          "const": true
        }
      }
    }
  },
  "$comment": "One receipt per actually attempted inverse child; no proof of remote/domain outcome is asserted. Failure to deliver prevents the following child. Literal argv is preserved."
}
