{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:recall:v1",
  "title": "Native recall records, recorded provenance, and byte-exact overflow pages",
  "description": "First-argument selectors only. Parsing does not establish chain cryptographic verification. Truncated denotes a requested page with continuation; source read errors never become empty successful collections. Overflow read offsets/limits are bytes, other overflow selectors use result-row offsets.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "source",
        "results",
        "analysis",
        "matched",
        "offset",
        "next_offset",
        "truncated",
        "error",
        "errno"
      ],
      "properties": {
        "schema": {
          "const": "jash.recall.v1"
        },
        "operation": {
          "enum": [
            "commands",
            "stats",
            "adoption",
            "why",
            "overflow_list",
            "overflow_read",
            "overflow_head",
            "overflow_tail",
            "overflow_grep"
          ]
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/chain_source"
            },
            {
              "$ref": "#/$defs/overflow_source"
            }
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/chain_entry"
              },
              {
                "$ref": "#/$defs/stat"
              },
              {
                "$ref": "#/$defs/feature"
              },
              {
                "$ref": "#/$defs/capture"
              },
              {
                "$ref": "#/$defs/capture_bytes"
              },
              {
                "$ref": "#/$defs/capture_line"
              }
            ]
          },
          "maxItems": 500
        },
        "analysis": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/aggregate"
            },
            {
              "$ref": "#/$defs/why"
            }
          ]
        },
        "matched": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "next_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "commands"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/chain_entry"
                },
                "maxItems": 500
              },
              "analysis": {
                "type": "null"
              },
              "source": {
                "$ref": "#/$defs/chain_source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "stats"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/stat"
                },
                "maxItems": 500
              },
              "analysis": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/aggregate"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "$ref": "#/$defs/chain_source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "adoption"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/feature"
                },
                "maxItems": 500
              },
              "analysis": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/aggregate"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "$ref": "#/$defs/chain_source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "why"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "results": {
                "type": "array",
                "maxItems": 0
              },
              "analysis": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/why"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "$ref": "#/$defs/chain_source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "overflow_list"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/capture"
                },
                "maxItems": 500
              },
              "analysis": {
                "type": "null"
              },
              "source": {
                "$ref": "#/$defs/overflow_source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "overflow_read"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/capture_bytes"
                },
                "maxItems": 500
              },
              "analysis": {
                "type": "null"
              },
              "source": {
                "$ref": "#/$defs/overflow_source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "overflow_head",
                  "overflow_tail",
                  "overflow_grep"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/capture_line"
                },
                "maxItems": 500
              },
              "analysis": {
                "type": "null"
              },
              "source": {
                "$ref": "#/$defs/overflow_source"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.recall.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.recall.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ],
  "$defs": {
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "chain_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "timestamp_seconds",
        "timestamp_nanoseconds",
        "source_line",
        "status",
        "hash_recorded",
        "tag",
        "command_recorded",
        "cwd_recorded",
        "repo",
        "session",
        "duration_ms"
      ],
      "properties": {
        "sequence": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
