{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:goal:v1",
  "description": "Current goal state and real checkpoint publication phases. A verify checkpoint is a caller-recorded claim, not independent execution proof. Log and current marker are two atomic file publications, not one multi-file transaction; their applied/durable fields expose partial outcomes. Recall uses bounded nofollow regex search of the existing store, then lexical path pages.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "current",
        "checkpoint",
        "matches",
        "total",
        "offset",
        "next_offset",
        "truncated",
        "scan_complete",
        "id_reserved",
        "applied",
        "durable",
        "log_applied",
        "log_durable",
        "current_applied",
        "current_durable",
        "environment_applied",
        "error",
        "errno"
      ],
      "properties": {
        "schema": {
          "const": "jash.goal.v1"
        },
        "operation": {
          "enum": [
            "status",
            "begin",
            "step",
            "verify",
            "close",
            "recall"
          ]
        },
        "current": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "text",
                "cwd",
                "timestamp",
                "rc_hint",
                "verification"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "kind": {
                  "enum": [
                    "begin",
                    "step",
                    "verify",
                    "close"
                  ]
                },
                "text": {
                  "oneOf": [
                    {
                      "type": "string",
                      "maxLength": 511
                    },
                    {
                      "$ref": "#/$defs/bytes"
                    }
                  ]
                },
                "cwd": {
                  "oneOf": [
                    {
                      "type": "string",
                      "maxLength": 255
                    },
                    {
                      "$ref": "#/$defs/bytes"
                    }
                  ]
                },
                "timestamp": {
                  "type": "integer",
                  "minimum": 1
                },
                "rc_hint": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                "verification": {
                  "const": "user_recorded_claim"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "text",
                "cwd",
                "timestamp",
                "rc_hint",
                "verification"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "kind": {
                  "enum": [
                    "begin",
                    "step",
                    "verify",
                    "close"
                  ]
                },
                "text": {
                  "oneOf": [
                    {
                      "type": "string",
                      "maxLength": 511
                    },
                    {
                      "$ref": "#/$defs/bytes"
                    }
                  ]
                },
                "cwd": {
                  "oneOf": [
                    {
                      "type": "string",
                      "maxLength": 255
                    },
                    {
                      "$ref": "#/$defs/bytes"
                    }
                  ]
                },
                "timestamp": {
                  "type": "integer",
                  "minimum": 1
                },
                "rc_hint": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                "verification": {
                  "const": "user_recorded_claim"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "matches": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 4095
              },
              {
                "$ref": "#/$defs/bytes"
              }
            ]
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "next_offset": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "scan_complete": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "id_reserved": {
          "type": "boolean"
        },
        "applied": {
          "type": "boolean"
        },
        "durable": {
          "type": "boolean"
        },
        "log_applied": {
          "type": "boolean"
        },
        "log_durable": {
          "type": "boolean"
        },
        "current_applied": {
          "type": "boolean"
        },
        "current_durable": {
          "type": "boolean"
        },
        "environment_applied": {
          "type": "boolean"
        },
        "error": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.goal.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.goal.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ],
  "$defs": {
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
