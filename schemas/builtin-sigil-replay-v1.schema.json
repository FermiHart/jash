{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:sigil-replay:v1",
  "title": "Sigil replay batch with per-child receipt boundaries",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "results",
        "complete",
        "status"
      ],
      "properties": {
        "schema": {
          "const": "jash.sigil.replay.v1"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "timestamp_ns",
              "command",
              "stored_exit_code",
              "chain_hash",
              "executed",
              "pid",
              "actual_exit_code",
              "exit_code_matches",
              "comparison_scope",
              "execution_shell",
              "child_output"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "timestamp_ns": {
                "type": "integer",
                "minimum": 0
              },
              "command": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              },
              "stored_exit_code": {
                "type": "integer"
              },
              "chain_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "executed": {
                "type": "boolean"
              },
              "pid": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actual_exit_code": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exit_code_matches": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "comparison_scope": {
                "const": "exit-code-only; not state or output determinism"
              },
              "execution_shell": {
                "anyOf": [
                  {
                    "const": "/bin/sh"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "child_output": {
                "anyOf": [
                  {
                    "const": "stderr"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 128
        },
        "complete": {
          "type": "boolean"
        },
        "status": {
          "type": "integer"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.sigil.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.sigil.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer"
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ]
}
