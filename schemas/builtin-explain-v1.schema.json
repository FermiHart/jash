{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:explain:v1",
  "title": "Existing explain and sense heuristic engine projected to JSON and JTV2",
  "description": "Compatibility result keeps steps/blast and optional risk without adding a schema key. This is bounded quote-aware segment classification, not a shell parse or execution plan; nothing is executed. recoverable/how are policy hints only, not inspected recovery guarantees. First format selector, optional --risk; remaining literal argv pieces joined by spaces as legacy. Limits:4095 input bytes,32 segments,62-byte verb,510-byte redirect preview. Risk is the existing shared engine; danger/critical status1/124 remains a COMPLETE evaluated result with zero stream errors.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "blast"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cmd",
              "effect",
              "recoverable",
              "how",
              "writes",
              "target"
            ],
            "properties": {
              "cmd": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              },
              "effect": {
                "enum": [
                  "read",
                  "delete",
                  "trash",
                  "move",
                  "copy",
                  "create",
                  "chmod",
                  "network",
                  "opaque"
                ]
              },
              "recoverable": {
                "type": "boolean",
                "description": "Policy-based heuristic from the existing classifier. Artifact presence and restoration preconditions are not assessed."
              },
              "how": {
                "type": "string"
              },
              "writes": {
                "type": "boolean"
              },
              "target": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              }
            }
          },
          "maxItems": 32
        },
        "blast": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mutations",
            "delete",
            "write",
            "network",
            "opaque"
          ],
          "properties": {
            "mutations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "delete": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "write": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "network": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "opaque": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "band",
            "reason"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "band": {
              "enum": [
                "safe",
                "caution",
                "danger",
                "critical"
              ]
            },
            "reason": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "encoding",
                    "data"
                  ],
                  "properties": {
                    "encoding": {
                      "const": "base64"
                    },
                    "data": {
                      "type": "string",
                      "contentEncoding": "base64",
                      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                    }
                  }
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "score": {
                    "minimum": 0,
                    "maximum": 19
                  }
                }
              },
              "then": {
                "properties": {
                  "band": {
                    "const": "safe"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "score": {
                    "minimum": 20,
                    "maximum": 49
                  }
                }
              },
              "then": {
                "properties": {
                  "band": {
                    "const": "caution"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "score": {
                    "minimum": 50,
                    "maximum": 79
                  }
                }
              },
              "then": {
                "properties": {
                  "band": {
                    "const": "danger"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "score": {
                    "minimum": 80,
                    "maximum": 100
                  }
                }
              },
              "then": {
                "properties": {
                  "band": {
                    "const": "critical"
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.explain.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.explain.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ]
}
