{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:proc:v1",
  "title": "Jash proc structured contract",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "snapshot",
        "pid",
        "restored_pid",
        "applied",
        "durable",
        "restore_scope",
        "error",
        "errno"
      ],
      "properties": {
        "schema": {
          "const": "jash.proc.v1"
        },
        "operation": {
          "enum": [
            "snapshot",
            "restore"
          ]
        },
        "snapshot": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "data"
              ],
              "properties": {
                "encoding": {
                  "const": "base64"
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            }
          ]
        },
        "pid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "restored_pid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "applied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "durable": {
          "type": "boolean"
        },
        "restore_scope": {
          "const": "root-argv-only; inherited environment; stdin closed; stdout to stderr"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snap_a",
        "snap_b",
        "size_a",
        "size_b",
        "identical",
        "comparison"
      ],
      "properties": {
        "snap_a": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "data"
              ],
              "properties": {
                "encoding": {
                  "const": "base64"
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            }
          ]
        },
        "snap_b": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "data"
              ],
              "properties": {
                "encoding": {
                  "const": "base64"
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            }
          ]
        },
        "size_a": {
          "type": "integer",
          "minimum": 0
        },
        "size_b": {
          "type": "integer",
          "minimum": 0
        },
        "identical": {
          "type": "boolean"
        },
        "comparison": {
          "const": "byte-exact"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "root_pid",
        "timestamp",
        "tree",
        "scope",
        "consistency",
        "complete",
        "restore_scope"
      ],
      "properties": {
        "version": {
          "const": 3
        },
        "root_pid": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "integer"
        },
        "tree": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pid",
            "argv",
            "env",
            "fds",
            "children",
            "children_available",
            "start_ticks",
            "environment_errno",
            "descriptors_errno"
          ],
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 0
            },
            "argv": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              },
              "maxItems": 4096
            },
            "env": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "encoding",
                          "data"
                        ],
                        "properties": {
                          "encoding": {
                            "const": "base64"
                          },
                          "data": {
                            "type": "string",
                            "contentEncoding": "base64",
                            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                          }
                        }
                      }
                    ]
                  },
                  "maxItems": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "fds": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "fd",
                      "target"
                    ],
                    "properties": {
                      "fd": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "target": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "encoding",
                              "data"
                            ],
                            "properties": {
                              "encoding": {
                                "const": "base64"
                              },
                              "data": {
                                "type": "string",
                                "contentEncoding": "base64",
                                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                              }
                            }
                          }
                        ]
                      }
                    }
                  },
                  "maxItems": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "children": {
              "type": "null"
            },
            "children_available": {
              "const": false
            },
            "start_ticks": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "environment_errno": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "descriptors_errno": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "scope": {
          "const": "root-process"
        },
        "consistency": {
          "const": "process-identity; fields sampled separately"
        },
        "complete": {
          "type": "boolean"
        },
        "restore_scope": {
          "const": "root-argv-only"
        }
      }
    }
  ]
}
