{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:alias:v1",
  "title": "Jash alias native report v1",
  "description": "Native alias queries and mutation outcomes. Per-item errors preserve prior successful operations; complete refers to collection of receipts. Input syntax is checked before mutation. Values are reversible bytes, with no accepted truncation. Stateful operations admit a checked header before effects and flush each receipt before the next action. Mutation receipts bypass presentation budgets. Collection failure after admission retains prior receipts with complete:false, status:75 and effects_may_have_applied:true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "complete",
    "status",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "jash.alias.v1"
    },
    "command": {
      "enum": [
        "alias",
        "unalias"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "items": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "operation",
          "before",
          "value",
          "present",
          "changed",
          "ok",
          "error"
        ],
        "properties": {
          "name": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              }
            ]
          },
          "operation": {
            "enum": [
              "list",
              "get",
              "set",
              "remove"
            ]
          },
          "before": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "present": {
            "type": "boolean"
          },
          "changed": {
            "type": "boolean"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "effects_may_have_applied"
      ],
      "properties": {
        "code": {
          "const": "collection_limit_exceeded"
        },
        "effects_may_have_applied": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "status": {
            "const": 75
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
