{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:debug:v1",
  "title": "Debug scanner and observed current-shell locals",
  "description": "Parse exposes the existing quote-aware space/tab scanner; it is not the shell parser and does not execute input. Locals observe the exact __LOCAL_VARS__ list and current environment, retaining unset values explicitly. Interactive --trace remains a terminal-control operation.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "input",
        "tokens",
        "single_quote_open",
        "double_quote_open",
        "analysis_scope",
        "executed"
      ],
      "properties": {
        "schema": {
          "const": "jash.debug.v1"
        },
        "operation": {
          "const": "parse"
        },
        "input": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "data"
              ],
              "properties": {
                "encoding": {
                  "const": "base64"
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            }
          ]
        },
        "tokens": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "byte_offset",
              "byte_length"
            ],
            "properties": {
              "text": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              },
              "byte_offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "byte_length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            }
          }
        },
        "single_quote_open": {
          "type": "boolean"
        },
        "double_quote_open": {
          "type": "boolean"
        },
        "analysis_scope": {
          "const": "quote_aware_space_tab_scanner_not_shell_parser"
        },
        "executed": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "source",
        "locals",
        "complete",
        "total"
      ],
      "properties": {
        "schema": {
          "const": "jash.debug.v1"
        },
        "operation": {
          "const": "locals"
        },
        "source": {
          "const": "__LOCAL_VARS___and_current_shell_environment"
        },
        "locals": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "set",
              "value"
            ],
            "properties": {
              "name": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    }
                  }
                ]
              },
              "set": {
                "type": "boolean"
              },
              "value": {
                "anyOf": [
                  {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "encoding",
                          "data"
                        ],
                        "properties": {
                          "encoding": {
                            "const": "base64"
                          },
                          "data": {
                            "type": "string",
                            "contentEncoding": "base64",
                            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "set": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "complete": {
          "const": true
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.debug.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      }
    }
  ]
}
