{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:weave:v1",
  "title": "Jash weave structured contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results",
    "status",
    "tasks",
    "failed",
    "completed_tasks",
    "complete"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "cmd",
          "rc",
          "out",
          "truncated",
          "out_bytes",
          "retained_bytes",
          "started",
          "capture_errno",
          "output_scope"
        ],
        "properties": {
          "name": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  }
                }
              }
            ]
          },
          "cmd": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  }
                }
              }
            ]
          },
          "rc": {
            "type": "integer"
          },
          "out": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  }
                }
              }
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "out_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "retained_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16384
          },
          "started": {
            "type": "boolean"
          },
          "capture_errno": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_scope": {
            "const": "combined-stdout-stderr-prefix"
          }
        }
      },
      "maxItems": 32
    },
    "status": {
      "enum": [
        "failed",
        "completed"
      ]
    },
    "tasks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "completed_tasks": {
      "type": "integer",
      "minimum": 0
    },
    "complete": {
      "type": "boolean"
    }
  },
  "$comment": "Declaration order is retained. Retained output is a bounded prefix; observed byte count measures the drained stream. A child failure is an observed result, not missing output."
}
