{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:checkpoint:action:v1",
  "description": "Checkpoint publication receipts from the checked local store. A checkpoint is a legacy bounded timeline depth plus CWD, not a filesystem snapshot. applied is publication visibility; durable requires successful directory sync. Failed publication may still be applied. Output admission precedes store locking/creation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "complete",
    "status",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "jash.checkpoint.action.v1"
    },
    "command": {
      "const": "checkpoint"
    },
    "complete": {
      "type": "boolean"
    },
    "status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "items": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "name",
          "path",
          "depth",
          "ts",
          "cwd",
          "applied",
          "durable",
          "error",
          "record_fields"
        ],
        "properties": {
          "operation": {
            "const": "create"
          },
          "name": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              }
            ]
          },
          "depth": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "ts": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cwd": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "applied": {
            "type": "boolean"
          },
          "durable": {
            "type": "boolean"
          },
          "error": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "data"
                ],
                "properties": {
                  "encoding": {
                    "const": "base64"
                  },
                  "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "record_fields": {
            "const": "legacy_bounded"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "effects_may_have_applied"
      ],
      "properties": {
        "code": {
          "const": "collection_limit_exceeded"
        },
        "effects_may_have_applied": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "status": {
            "const": 75
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
