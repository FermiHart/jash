{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jash:semantic:forge:v1",
  "title": "Jash forge semantic result v1",
  "description": "Existing unfinished test scaffold; no generated file or validation is claimed. JSON and JSON projection of the JTV2 record share this field contract. Native kinds additionally preserve PATH/SYMBOL/FILESIZE and exact I64/U64. The terminal is a separate JTV2 contract; this document alone does not prove stream completion.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "template",
        "description",
        "status",
        "validated",
        "implemented",
        "files_written"
      ],
      "properties": {
        "schema": {
          "const": "jash.forge.v1"
        },
        "template": {
          "const": "test"
        },
        "description": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "data"
              ],
              "properties": {
                "encoding": {
                  "const": "base64"
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            }
          ]
        },
        "status": {
          "const": "scaffold"
        },
        "validated": {
          "const": false
        },
        "implemented": {
          "const": false
        },
        "files_written": {
          "const": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "jash.forge.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error",
        "command_status",
        "effects_may_have_applied"
      ],
      "properties": {
        "schema": {
          "const": "jash.forge.v1"
        },
        "error": {
          "const": "semantic_value_limit"
        },
        "command_status": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "effects_may_have_applied": {
          "type": "boolean"
        }
      }
    }
  ]
}
